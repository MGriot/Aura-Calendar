# ── Backend ──────────────────────────────
BACKEND_PORT=8000

# ── Frontend ─────────────────────────────
FRONTEND_PORT=5173
VITE_API_TARGET=http://localhost:8000

# ── Security ─────────────────────────────
# Extra directories local CSVs may be read from (uploads/ and data/ are always allowed; os.pathsep-separated)
CSV_ALLOWED_DIRS=
# Comma-separated browser origins allowed to call the API directly (the UI uses the same-origin proxy)
CORS_ORIGINS=http://localhost:5173
